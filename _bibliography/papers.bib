}

@inproceedings{vyas2026chora,
  bibtex_show={true},
  abbr={IEEE TAC},
  title={Haptically Experienced Animacy Facilitates Emotion Regulation: A Theory-Driven Investigation},
  author={Vyas, Preeti and Guta, Bereket and Zhou, Tim G. and Himam, Noor Naila and Uusberg, Andero and MacLean, Karon E.},
  abstract={We developed CHORA, a zoomorphic robot featuring biomimetic breathing and heartbeat behaviors. Through a mixed-methods study with 30 participants, we gathered physiological data, self-reports, and interview feedback. Our findings demonstrate how haptically experienced animacy can support emotional regulation by enabling four different coping strategies.},
